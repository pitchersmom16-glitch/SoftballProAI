      ]
    },
    {
      "name": "Drill Lookups",
      "item": [
        {
          "name": "Get Corrective Drills",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/brain/corrective-drills?issues=hunched forward,weak leg drive",
              "host": ["{{baseUrl}}"],
              "path": ["api", "brain", "corrective-drills"],
              "query": [
                {
                  "key": "issues",
                  "value": "hunched forward,weak leg drive"
                }
              ]
            },
            "description": "Get drills for specific mechanical issues"
          }
        },
        {
          "name": "Get Drills by Tag",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/brain/drills-by-tag?tag=posture&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "brain", "drills-by-tag"],
              "query": [
                {
                  "key": "tag",
                  "value": "posture"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            },
            "description": "Find drills by mechanic tag"
          }
        },
        {
          "name": "Get Drills by Expert",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/brain/drills-by-expert?expert=Amanda Scarborough&limit=5",
              "host": ["{{baseUrl}}"],
              "path": ["api", "brain", "drills-by-expert"],
              "query": [
                {
                  "key": "expert",
                  "value": "Amanda Scarborough"
                },
                {
                  "key": "limit",
                  "value": "5"
                }
              ]
            },
            "description": "Get all drills from a specific expert"
          }
        }
      ]
    },
    {
      "name": "Training (Admin)",
      "item": [
        {
          "name": "Add New Drill",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Drill\",\n  \"category\": \"PITCHING\",\n  \"difficulty\": \"Intermediate\",\n  \"description\": \"Test drill description\",\n  \"videoUrl\": \"https://youtube.com/...\",\n  \"mechanicTags\": [\"posture\", \"leg-drive\"],\n  \"expertSource\": \"Amanda Scarborough\",\n  \"equipment\": [\"ball\", \"net\"],\n  \"ageRange\": \"10U-18U\",\n  \"issueAddressed\": \"hunched forward\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/brain/train/drill",
              "host": ["{{baseUrl}}"],
              "path": ["api", "brain", "train", "drill"]
            },
            "description": "Add a new drill to the knowledge base"
          }
        },
