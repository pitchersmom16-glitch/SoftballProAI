  },
  "item": [
    {
      "name": "Brain Analysis",
      "item": [
        {
          "name": "Analyze Pitching Mechanics",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"skillType\": \"PITCHING\",\n  \"detectedIssues\": [\"hunched forward\", \"weak leg drive\"],\n  \"athleteLevel\": \"Intermediate\",\n  \"limit\": 3\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/brain/analyze",
              "host": ["{{baseUrl}}"],
              "path": ["api", "brain", "analyze"]
            },
            "description": "Analyze pitching mechanics and get drill recommendations"
          }
        },
        {
          "name": "Analyze Hitting Mechanics",
